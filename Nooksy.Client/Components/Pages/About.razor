@page "/about"
@inject NavigationManager NavigationManager

<PageTitle>About Nooksy - Children's Ebook Store</PageTitle>

<div class="container-xxl py-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6 text-start">
            <a href="" class="btn btn-sm btn-link text-decoration-none text-muted font-display fw-bold mb-4 p-0">
                <i class="bi bi-arrow-left me-2"></i> Back to Home
            </a>

            <h1 class="font-display fw-extrabold text-primary mb-4">About Nooksy</h1>

            <div class="nooksy-card p-4 bg-white mb-4" style="border-radius: var(--radius-lg);">
                <h4 class="font-display fw-bold text-primary mb-3"><i class="bi bi-heart-fill text-accent me-2"></i> Our Story</h4>
                <p class="font-body text-text-muted lh-lg">
                    Nooksy is a passionate children's ebook store dedicated to bringing the joy of reading to kids everywhere.
                    We believe every child deserves access to wonderful stories that spark imagination, curiosity, and a lifelong love of learning.
                </p>
            </div>

            <div class="nooksy-card p-4 bg-white mb-4" style="border-radius: var(--radius-lg);">
                <h4 class="font-display fw-bold text-primary mb-3"><i class="bi bi-book me-2 text-accent"></i> What We Offer</h4>
                <ul class="font-body text-text-muted lh-lg">
                    <li>Thousands of curated children's ebooks across every genre</li>
                    <li>Bulk discounts for schools and libraries (save up to 40% on 100+ copies)</li>
                    <li>Secure instant delivery &mdash; start reading in minutes</li>
                    <li>B2B invoicing for company and institutional accounts</li>
                </ul>
            </div>

            <div class="nooksy-card p-4 bg-white" style="border-radius: var(--radius-lg);">
                <h4 class="font-display fw-bold text-primary mb-3"><i class="bi bi-envelope me-2 text-accent"></i> Get in Touch</h4>
                <p class="font-body text-text-muted mb-1"><i class="bi bi-envelope me-2"></i> support@nooksy.com</p>
                <p class="font-body text-text-muted"><i class="bi bi-telephone me-2"></i> +1 (800) 555-NOOK</p>
            </div>
        </div>
    </div>
</div>
