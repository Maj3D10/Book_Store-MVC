@page "/admin/companies/upsert"
@page "/admin/companies/upsert/{id:int}"
@layout Nooksy.Client.Components.Layout.AdminLayout
@attribute [Authorize(Roles = "Admin,Employee")]
@inject IUnitOfWork UnitOfWork
@inject IToastService ToastService
@inject NavigationManager NavigationManager
@using Nooksy.Client.Components.UI

<PageTitle>@(company.Id == 0 ? "Create Company" : "Edit Company") - Nooksy</PageTitle>

<div class="d-flex flex-column gap-4 text-start" style="max-width: 700px;">
    <div>
        <a href="admin/companies" class="btn btn-sm btn-link text-decoration-none text-muted font-display fw-bold p-0 mb-3">
            <i class="bi bi-arrow-left me-2"></i> Back to Companies
        </a>
        <h2 class="font-display fw-extrabold text-primary m-0">
            @(company.Id == 0 ? "Create Company" : "Edit Company")
        </h2>
    </div>

    <div class="nooksy-card p-4 bg-white" style="border-radius: var(--radius-lg); border-color: var(--color-border);">
        <EditForm Model="company" OnValidSubmit="SaveCompany">
            <DataAnnotationsValidator />
            <ValidationSummary class="text-danger small mb-3" />

            <div class="row g-3 font-body small">
                <div class="col-12 col-md-6">
                    <label class="form-label fw-bold text-primary">Company Name</label>
                    <InputText @bind-Value="company.Name" class="form-control" placeholder="Company name" style="border-radius: var(--radius-sm); border-color: var(--color-border);" />
                    <ValidationMessage For="() => company.Name" class="text-danger small" />
                </div>
                <div class="col-12 col-md-6">
                    <label class="form-label fw-bold text-primary">Phone Number</label>
                    <InputText @bind-Value="company.PhoneNumber" class="form-control" placeholder="(555) 000-0000" style="border-radius: var(--radius-sm); border-color: var(--color-border);" />
                    <ValidationMessage For="() => company.PhoneNumber" class="text-danger small" />
                </div>
                <div class="col-12">
                    <label class="form-label fw-bold text-primary">Street Address</label>
                    <InputText @bind-Value="company.StreetAddress" class="form-control" placeholder="123 Main St" style="border-radius: var(--radius-sm); border-color: var(--color-border);" />
                </div>
                <div class="col-12 col-md-4">
                    <label class="form-label fw-bold text-primary">City</label>
                    <InputText @bind-Value="company.City" class="form-control" placeholder="City" style="border-radius: var(--radius-sm); border-color: var(--color-border);" />
                </div>
                <div class="col-6 col-md-4">
                    <label class="form-label fw-bold text-primary">State</label>
                    <InputText @bind-Value="company.State" class="form-control" placeholder="IL" style="border-radius: var(--radius-sm); border-color: var(--color-border);" />
                </div>
                <div class="col-6 col-md-4">
                    <label class="form-label fw-bold text-primary">Postal Code</label>
                    <InputText @bind-Value="company.PostalCode" class="form-control" placeholder="12345" style="border-radius: var(--radius-sm); border-color: var(--color-border);" />
                </div>
            </div>

            <div class="d-flex align-items-center gap-3 mt-4">
                <NooksyButton Variant="NooksyButton.NooksyButtonVariant.Primary" Type="submit" IsLoading="isSaving">
                    <i class="bi bi-check-lg me-1"></i> @(company.Id == 0 ? "Create Company" : "Update Company")
                </NooksyButton>
                <a href="admin/companies" class="btn-nooksy btn-nooksy-outline">Cancel</a>
            </div>
        </EditForm>
    </div>
</div>

@code {
    [Parameter] public int Id { get; set; }

    private Company company = new();
    private bool isSaving = false;

    protected override void OnInitialized()
    {
        if (Id != 0)
        {
            company = UnitOfWork.Company.Get(u => u.Id == Id);
        }
    }

    private async Task SaveCompany()
    {
        isSaving = true;
        try
        {
            if (company.Id == 0)
            {
                UnitOfWork.Company.Add(company);
                ToastService.ShowSuccess($"Company \"{company.Name}\" created successfully!");
            }
            else
            {
                UnitOfWork.Company.Update(company);
                ToastService.ShowSuccess($"Company \"{company.Name}\" updated successfully!");
            }
            UnitOfWork.Save();
            NavigationManager.NavigateTo("admin/companies");
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Could not save company.");
        }
        finally
        {
            isSaving = false;
        }
    }
}
