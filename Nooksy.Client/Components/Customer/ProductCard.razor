@inject IUnitOfWork UnitOfWork
@inject AuthenticationStateProvider AuthStateProvider
@inject Nooksy.Client.State.CartState CartState
@inject IToastService ToastService
@inject NavigationManager NavigationManager
@using System.Security.Claims

<div class="nooksy-card nooksy-card-hover h-100 d-flex flex-column" style="position: relative; cursor: pointer; transition: all 0.3s;"
     @onclick="NavigateToDetails">
    <!-- Cover Image (3/4 aspect ratio) -->
    <div class="position-relative w-100" style="aspect-ratio: 3/4; overflow: hidden; background: #eef5fa;">
        @if (Product.ProductImages != null && Product.ProductImages.Any())
        {
            <img src="@Product.ProductImages.First().ImageUrl" class="w-100 h-100" style="object-fit: cover;" alt="Book cover" />
        }
        else
        {
            <!-- Default placeholder cover -->
            <div class="w-100 h-100 d-flex flex-column align-items-center justify-content-center text-muted p-3">
                <i class="bi bi-book fs-1 mb-2 text-primary opacity-50"></i>
                <span class="small fw-bold">No cover yet</span>
            </div>
        }
        
        <!-- Hover Overlay sliding up "Quick Add" -->
        <div class="hover-overlay position-absolute w-100 px-3 pb-3" style="bottom: 0; left: 0; background: linear-gradient(to top, rgba(26,43,60,0.8) 0%, rgba(26,43,60,0) 100%); display: flex; align-items: flex-end; justify-content: center; height: 50%; opacity: 0; transition: all 0.25s ease;"
             @onclick:stopPropagation="true">
            <Nooksy.Client.Components.UI.NooksyButton Variant="Nooksy.Client.Components.UI.NooksyButton.NooksyButtonVariant.Accent" 
                          Size="sm" 
                          Class="w-100 border-0" 
                          IsLoading="isAddingToCart"
                          OnClick="AddToCart">
                <i class="bi bi-plus-lg me-1"></i> Add to Cart
            </Nooksy.Client.Components.UI.NooksyButton>
        </div>
    </div>

    <!-- Product Text Details -->
    <div class="p-3 d-flex flex-column flex-grow-1 justify-content-between">
        <div>
            <!-- Book Title (Nunito, max 2 lines with ellipsis) -->
            <h5 class="font-display fw-bold mb-1 text-truncate-2" style="font-size: 1.05rem; line-height: 1.35; height: 2.7rem; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; white-space: normal;">
                @Product.Title
            </h5>
            <!-- Author name -->
            <span class="text-text-muted small d-block mb-3">By @Product.Author</span>
        </div>

        <div>
            <!-- Pricing -->
            <div class="d-flex align-items-baseline gap-2 mb-3">
                <span class="fw-bold fs-5 text-primary">$@Product.Price.ToString("F2")</span>
                @if (Product.ListPrice > Product.Price)
                {
                    <span class="text-decoration-line-through text-muted small">$@Product.ListPrice.ToString("F2")</span>
                }
            </div>

            <!-- Add to Cart Full-width Button for Mobile / Non-hover -->
            <div class="d-lg-none" @onclick:stopPropagation="true">
                <Nooksy.Client.Components.UI.NooksyButton Variant="Nooksy.Client.Components.UI.NooksyButton.NooksyButtonVariant.Accent" 
                              Size="sm" 
                              Class="w-100" 
                              IsLoading="isAddingToCart"
                              OnClick="AddToCart">
                    <i class="bi bi-cart-plus me-1"></i> Add to Cart
                </Nooksy.Client.Components.UI.NooksyButton>
            </div>
        </div>
    </div>
</div>

<style>
    .nooksy-card-hover:hover .hover-overlay {
        opacity: 1 !important;
    }
    .text-truncate-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }
</style>

@code {
    [Parameter] public Product Product { get; set; } = new();

    private bool isAddingToCart = false;

    private void NavigateToDetails()
    {
        NavigationManager.NavigateTo($"product/{Product.Id}");
    }

    private async Task AddToCart()
    {
        isAddingToCart = true;
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            var user = authState.User;

            if (user.Identity == null || !user.Identity.IsAuthenticated)
            {
                // Unauthenticated - redirect to login
                ToastService.ShowWarning("Please log in to add books to your box.");
                NavigationManager.NavigateTo("Account/Login");
                return;
            }

            var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (string.IsNullOrEmpty(userId)) return;

            // Add or merge shopping cart
            var cartFromDb = UnitOfWork.ShoppingCart.Get(u => u.ApplicationUserId == userId && u.ProductId == Product.Id);
            if (cartFromDb == null)
            {
                var newCart = new ShoppingCart
                {
                    ApplicationUserId = userId,
                    ProductId = Product.Id,
                    Count = 1
                };
                UnitOfWork.ShoppingCart.Add(newCart);
                ToastService.ShowSuccess($"\"{Product.Title}\" has been added to your box!");
            }
            else
            {
                cartFromDb.Count++;
                UnitOfWork.ShoppingCart.Update(cartFromDb);
                ToastService.ShowSuccess($"Incremented quantity of \"{Product.Title}\" in your box.");
            }

            UnitOfWork.Save();

            // Refresh Navbar Cart Badge Count
            var totalCarts = UnitOfWork.ShoppingCart.GetAll(u => u.ApplicationUserId == userId).Count();
            CartState.SetCount(totalCarts);
        }
        catch (Exception ex)
        {
            ToastService.ShowError("Oops! Something went wrong adding the book to your cart.");
        }
        finally
        {
            isAddingToCart = false;
        }
    }
}
