<button type="@Type"
        class="btn-nooksy btn-nooksy-@Variant.ToString().ToLower() @GetSizeClass() @Class"
        disabled="@(Disabled || IsLoading)"
        @onclick="OnClick">
    @if (IsLoading)
    {
        <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
        <span>Loading...</span>
    }
    else
    {
        @ChildContent
    }
</button>

@code {
    [Parameter] public NooksyButtonVariant Variant { get; set; } = NooksyButtonVariant.Primary;
    [Parameter] public string Size { get; set; } = "md";
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public bool IsLoading { get; set; } = false;
    [Parameter] public string Type { get; set; } = "button";
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public EventCallback<Microsoft.AspNetCore.Components.Web.MouseEventArgs> OnClick { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private string GetSizeClass() => Size.ToLower() switch
    {
        "sm" => "btn-sm py-1 px-3 fs-7",
        "lg" => "btn-lg py-3 px-5 fs-5",
        _ => "py-2 px-4"
    };

    public enum NooksyButtonVariant
    {
        Primary,
        Accent,
        Outline,
        OutlinePrimary,
        Danger
    }
}
