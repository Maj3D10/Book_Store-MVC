@inject Nooksy.Client.State.CartState CartState
@implements IDisposable

@if (CartState.CartCount > 0)
{
    <span class="position-absolute translate-middle badge rounded-pill nooksy-cart-badge @(isBouncing ? "cart-badge-active" : "")"
          style="top: 8px; left: calc(100% - 4px); background: var(--color-accent); color: white; border: 2px solid white; font-family: var(--font-display); font-size: 0.7rem; font-weight: 700; display: inline-flex; align-items: center; justify-content: center; min-width: 18px; min-height: 18px; padding: 2px 4px; box-shadow: var(--shadow-sm); z-index: 5;">
        @CartState.CartCount
    </span>
}

@code {
    private bool isBouncing = false;

    protected override void OnInitialized()
    {
        CartState.OnChange += UpdateBadge;
    }

    private async void UpdateBadge()
    {
        // Set bouncing state for animation, wait 300ms, reset bouncing state
        isBouncing = true;
        await InvokeAsync(StateHasChanged);
        
        await Task.Delay(300);
        isBouncing = false;
        await InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CartState.OnChange -= UpdateBadge;
    }
}
