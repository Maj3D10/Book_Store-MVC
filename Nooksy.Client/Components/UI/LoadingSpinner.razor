<div class="d-flex flex-column align-items-center justify-content-center py-5 text-center" style="gap: 1rem; min-height: 200px;">
    <div class="position-relative d-inline-flex align-items-center justify-content-center">
        <!-- Spinner Border -->
        <div class="spinner-border text-primary" role="status" style="width: 3.5rem; height: 3.5rem; border-width: 0.25rem;">
            <span class="visually-hidden">Loading...</span>
        </div>
        <!-- Soft pulsating character inside or background icon -->
        <i class="bi bi-book text-accent position-absolute" style="font-size: 1.25rem; animation: pulse 1.2s infinite ease-in-out;"></i>
    </div>
    <p class="text-muted m-0 font-display fw-bold" style="letter-spacing: 0.5px;">@Message</p>
</div>

<style>
    @@keyframes pulse {
        0% { transform: scale(0.9); opacity: 0.6; }
        50% { transform: scale(1.1); opacity: 1; }
        100% { transform: scale(0.9); opacity: 0.6; }
    }
</style>

@code {
    [Parameter] public string Message { get; set; } = "Opening book box...";
}
