@inherits LayoutComponentBase
@inject Nooksy.Client.State.CartState CartState
@inject IUnitOfWork UnitOfWork
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@using System.Security.Claims
@using Blazored.Toast.Configuration

<BlazoredToasts Position="ToastPosition.TopRight"
                Timeout="4"
                IconType="IconType.FontAwesome"
                SuccessClass="bg-success text-white"
                ErrorClass="bg-danger text-white"
                WarningClass="bg-warning text-dark"
                InfoClass="bg-info text-white" />

<div class="d-flex flex-column min-vh-100">
    <!-- Sticky Navbar -->
    <header class="nooksy-navbar py-2 px-3 shadow-sm sticky-top">
        <div class="container-xxl d-flex align-items-center justify-content-between flex-wrap gap-2">
            <!-- Left: Playful Logo -->
            <a href="" class="d-flex align-items-center gap-2 text-decoration-none" style="outline: none;">
                <!-- Playful SVG Logo -->
                <svg width="40" height="40" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="20" cy="20" r="20" fill="#4AABDB"/>
                    <path d="M12 28C12 21.3726 17.3726 16 24 16H28V28H12Z" fill="#E87D7D"/>
                    <circle cx="18" cy="18" r="4" fill="white"/>
                    <circle cx="24" cy="22" r="3" fill="white"/>
                </svg>
                <span class="fs-4 fw-bold font-display text-primary m-0" style="letter-spacing: -0.5px;">Nooksy</span>
            </a>

            <!-- Center: Shop Navigation Links -->
            <nav class="d-none d-md-flex align-items-center gap-3">
                <NavLink href="" class="nooksy-nav-link" Match="NavLinkMatch.All">Home</NavLink>
                <NavLink href="shop" class="nooksy-nav-link">Shop</NavLink>
                <NavLink href="about" class="nooksy-nav-link">About</NavLink>
                <AuthorizeView Roles="Admin,Employee">
                    <NavLink href="admin/dashboard" class="nooksy-nav-link text-accent">Admin Portal</NavLink>
                </AuthorizeView>
            </nav>

            <!-- Right: Search Bar, Cart, User Settings -->
            <div class="d-flex align-items-center gap-3 ms-auto ms-md-0">
                <!-- Search bar -->
                <div class="d-none d-lg-block position-relative" style="width: 200px;">
                    <input type="text" 
                           class="form-control form-control-sm ps-4 rounded-pill" 
                           placeholder="Search books..." 
                           style="border-color: var(--color-border); font-size: 0.85rem;" 
                           @bind="searchQuery"
                           @onkeydown="HandleSearch" />
                    <i class="bi bi-search position-absolute text-muted" style="left: 10px; top: 50%; transform: translateY(-50%); font-size: 0.8rem;"></i>
                </div>

                <!-- Shopping Cart Icon with Badge -->
                <AuthorizeView>
                    <Authorized>
                        <a href="cart" class="position-relative p-2 text-primary" style="outline: none;">
                            <i class="bi bi-cart3 fs-4" style="color: var(--color-primary);"></i>
                            <Nooksy.Client.Components.UI.CartBadge />
                        </a>
                    </Authorized>
                    <NotAuthorized>
                        <a href="Account/Login" class="position-relative p-2 text-primary" style="outline: none;">
                            <i class="bi bi-cart3 fs-4" style="color: var(--color-primary-dark);"></i>
                        </a>
                    </NotAuthorized>
                </AuthorizeView>

                <!-- Auth / Login Control -->
                <AuthorizeView>
                    <Authorized>
                        <div class="dropdown">
                            <button class="btn btn-sm d-flex align-items-center gap-2 border-0 dropdown-toggle" 
                                    type="button" 
                                    id="userMenuButton" 
                                    data-bs-toggle="dropdown" 
                                    aria-expanded="false"
                                    style="background: rgba(74, 171, 219, 0.08); border-radius: 100px; padding: 4px 12px;">
                                <div class="avatar bg-accent text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" 
                                     style="width: 24px; height: 24px; font-size: 0.75rem;">
                                    @context.User.Identity?.Name?.Substring(0, 1).ToUpper()
                                </div>
                                <span class="d-none d-sm-inline font-display fw-bold text-primary small">
                                    @context.User.Identity?.Name
                                </span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-md border-0 p-2 mt-2" aria-labelledby="userMenuButton" style="border-radius: var(--radius-md);">
                                <li>
                                    <h6 class="dropdown-header font-display fw-bold">My Account</h6>
                                </li>
                                <li><a class="dropdown-item rounded-lg small py-2" href="Account/Manage"><i class="bi bi-person me-2 text-muted"></i>Profile settings</a></li>
                                <AuthorizeView Roles="Admin,Employee" Context="inner">
                                    <li><a class="dropdown-item rounded-lg small py-2 text-accent" href="admin/dashboard"><i class="bi bi-speedometer2 me-2"></i>Admin Dashboard</a></li>
                                </AuthorizeView>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form action="Account/Logout" method="post" class="m-0">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="ReturnUrl" value="" />
                                        <button type="submit" class="dropdown-item rounded-lg small py-2 text-danger w-100 text-start border-0 bg-transparent">
                                            <i class="bi bi-box-arrow-right me-2"></i>Log out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </Authorized>
                    <NotAuthorized>
                        <div class="d-flex align-items-center gap-2">
                            <a href="Account/Login" class="btn-nooksy btn-nooksy-outline-primary py-1 px-3 fs-7" style="border-radius: 100px;">Log In</a>
                            <a href="Account/Register" class="btn-nooksy btn-nooksy-accent py-1 px-3 fs-7" style="border-radius: 100px;">Register</a>
                        </div>
                    </NotAuthorized>
                </AuthorizeView>

                <!-- Mobile Hamburger Menu Button -->
                <button class="btn btn-link d-md-none text-primary p-1 border-0" type="button" @onclick="ToggleMobileMenu" aria-label="Toggle navigation">
                    <i class="bi bi-list fs-3"></i>
                </button>
            </div>
        </div>
    </header>

    <!-- Mobile Drawer -->
    @if (isMobileMenuOpen)
    {
        <div class="mobile-drawer d-md-none position-fixed w-100 h-100" style="top: 0; left: 0; z-index: 1040; display: flex;">
            <div class="drawer-content p-4" style="width: 70%; height: 100%; background: white; box-shadow: var(--shadow-lg); animation: slideInLeft 0.3s ease;">
            <div class="backdrop" @onclick="ToggleMobileMenu" style="width: 30%; height: 100%; background: rgba(0,0,0,0.4); backdrop-filter: blur(2px);"></div>
                <div class="d-flex align-items-center justify-content-between mb-4 border-bottom pb-2">
                    <span class="fs-4 fw-bold font-display text-primary">Nooksy Menu</span>
                    <button class="btn-close" @onclick="ToggleMobileMenu"></button>
                </div>
                <div class="d-flex flex-column gap-3">
                    <a href="" class="nooksy-nav-link" @onclick="ToggleMobileMenu"><i class="bi bi-house me-2"></i>Home</a>
                    <a href="shop" class="nooksy-nav-link" @onclick="ToggleMobileMenu"><i class="bi bi-book me-2"></i>Shop</a>
                    <a href="about" class="nooksy-nav-link" @onclick="ToggleMobileMenu"><i class="bi bi-info-circle me-2"></i>About</a>
                    <AuthorizeView Roles="Admin,Employee">
                        <a href="admin/dashboard" class="nooksy-nav-link text-accent" @onclick="ToggleMobileMenu"><i class="bi bi-speedometer2 me-2"></i>Admin Dashboard</a>
                    </AuthorizeView>
                </div>
            </div>
        </div>
    }

    <!-- Main Content Body -->
    <main class="flex-grow-1">
        @Body
    </main>

    <!-- Footer -->
    <footer class="py-5 mt-auto" style="background: var(--color-border); border-top: 1px solid var(--color-border);">
        <div class="container-xxl">
            <div class="row g-4 justify-content-between">
                <div class="col-12 col-md-4">
                    <div class="d-flex align-items-center gap-2 mb-3">
                        <svg width="32" height="32" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <circle cx="20" cy="20" r="20" fill="#4AABDB"/>
                            <path d="M12 28C12 21.3726 17.3726 16 24 16H28V28H12Z" fill="#E87D7D"/>
                        </svg>
                        <span class="fs-4 fw-bold font-display text-primary">Nooksy</span>
                    </div>
                    <p class="text-text-muted small">Discover books kids love ♥. Friendly, playful, and trustworthy children's ebook store.</p>
                </div>
                <div class="col-6 col-md-3">
                    <h6 class="font-display fw-bold text-primary mb-3">Quick Links</h6>
                    <ul class="list-unstyled d-flex flex-column gap-2 small">
                        <li><a href="" class="text-decoration-none text-text-muted hover-link">Home</a></li>
                        <li><a href="shop" class="text-decoration-none text-text-muted hover-link">Browse Shop</a></li>
                        <li><a href="about" class="text-decoration-none text-text-muted hover-link">About Us</a></li>
                    </ul>
                </div>
                <div class="col-6 col-md-3">
                    <h6 class="font-display fw-bold text-primary mb-3">Contact Support</h6>
                    <p class="small text-text-muted m-0"><i class="bi bi-envelope me-2"></i>support@nooksy.com</p>
                    <p class="small text-text-muted mt-2"><i class="bi bi-telephone me-2"></i>+1 (800) 555-NOOK</p>
                </div>
            </div>
            <hr class="my-4 text-muted opacity-25">
            <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 small text-muted">
                <span>&copy; 2026 Nooksy Bookstore. All rights reserved.</span>
                <span class="d-flex align-items-center gap-1">Made with <i class="bi bi-heart-fill text-accent"></i> for kids everywhere</span>
            </div>
        </div>
    </footer>
</div>

<style>
    @@keyframes slideInLeft {
        from { transform: translateX(-100%); }
        to { transform: translateX(0); }
    }
    .hover-link {
        color: var(--color-text-muted);
        transition: color 0.2s;
    }
    .hover-link:hover {
        color: var(--color-primary);
    }
</style>

@code {
    private bool isMobileMenuOpen = false;

    private void ToggleMobileMenu() => isMobileMenuOpen = !isMobileMenuOpen;

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;

        if (user.Identity != null && user.Identity.IsAuthenticated)
        {
            var userId = user.FindFirst(ClaimTypes.NameIdentifier)?.Value;
            if (!string.IsNullOrEmpty(userId))
            {
                var carts = UnitOfWork.ShoppingCart.GetAll(u => u.ApplicationUserId == userId);
                var totalItems = carts.Count();
                CartState.SetCount(totalItems);
            }
        }
    }

    private string searchQuery = "";

    private void HandleSearch(KeyboardEventArgs e)
    {
        if (e.Key == "Enter" && !string.IsNullOrWhiteSpace(searchQuery))
        {
            NavigationManager.NavigateTo($"/shop?q={Uri.EscapeDataString(searchQuery)}");
        }
    }
}
