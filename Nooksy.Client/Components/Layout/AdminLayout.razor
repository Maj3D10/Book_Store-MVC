@inherits LayoutComponentBase
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager NavigationManager
@using System.Security.Claims
@using Blazored.Toast.Configuration

<BlazoredToasts Position="ToastPosition.TopRight"
                Timeout="3"
                IconType="IconType.FontAwesome"
                SuccessClass="bg-success text-white"
                ErrorClass="bg-danger text-white"
                WarningClass="bg-warning text-dark"
                InfoClass="bg-info text-white" />

<div class="d-flex min-vh-100">
    <!-- Collapsible Sidebar -->
    <aside class="admin-sidebar d-flex flex-column" style="width: @(isSidebarCollapsed ? "80px" : "260px"); transition: all 0.3s ease;">
        <!-- Logo Header -->
        <div class="d-flex align-items-center justify-content-between p-3 border-bottom border-white border-opacity-10" style="height: 70px; overflow: hidden;">
            <a href="" class="d-flex align-items-center gap-2 text-decoration-none text-white">
                <svg width="32" height="32" viewBox="0 0 40 40" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <circle cx="20" cy="20" r="20" fill="white"/>
                    <path d="M12 28C12 21.3726 17.3726 16 24 16H28V28H12Z" fill="#E87D7D"/>
                </svg>
                @if (!isSidebarCollapsed)
                {
                    <span class="fs-4 fw-bold font-display m-0" style="letter-spacing: -0.5px; animation: fadeIn 0.3s ease;">Nooksy</span>
                }
            </a>
            @if (!isSidebarCollapsed)
            {
                <button class="btn btn-sm btn-link text-white p-0 border-0 d-none d-md-block" @onclick="ToggleSidebar" aria-label="Collapse sidebar">
                    <i class="bi bi-chevron-left"></i>
                </button>
            }
        </div>

        <!-- Sidebar Navigation links -->
        <div class="flex-grow-1 py-3 d-flex flex-column gap-1 overflow-y-auto">
            <NavLink href="admin/dashboard" Match="NavLinkMatch.All" class="nav-link d-flex align-items-center gap-3">
                <i class="bi bi-speedometer2 fs-5"></i>
                @if (!isSidebarCollapsed)
                {
                    <span>Dashboard</span>
                }
            </NavLink>
            <NavLink href="admin/categories" Match="NavLinkMatch.Prefix" class="nav-link d-flex align-items-center gap-3">
                <i class="bi bi-tags fs-5"></i>
                @if (!isSidebarCollapsed)
                {
                    <span>Categories</span>
                }
            </NavLink>
            <NavLink href="admin/products" Match="NavLinkMatch.Prefix" class="nav-link d-flex align-items-center gap-3">
                <i class="bi bi-book fs-5"></i>
                @if (!isSidebarCollapsed)
                {
                    <span>Products</span>
                }
            </NavLink>
            <NavLink href="admin/companies" Match="NavLinkMatch.Prefix" class="nav-link d-flex align-items-center gap-3">
                <i class="bi bi-building fs-5"></i>
                @if (!isSidebarCollapsed)
                {
                    <span>Companies</span>
                }
            </NavLink>
            <NavLink href="admin/users" Match="NavLinkMatch.Prefix" class="nav-link d-flex align-items-center gap-3">
                <i class="bi bi-people fs-5"></i>
                @if (!isSidebarCollapsed)
                {
                    <span>Users</span>
                }
            </NavLink>
            <NavLink href="admin/orders" Match="NavLinkMatch.Prefix" class="nav-link d-flex align-items-center gap-3">
                <i class="bi bi-receipt fs-5"></i>
                @if (!isSidebarCollapsed)
                {
                    <span>Orders</span>
                }
            </NavLink>
        </div>

        <!-- Sidebar Footer Action -->
        <div class="p-3 border-top border-white border-opacity-10" style="overflow: hidden;">
            <a href="" class="nav-link d-flex align-items-center gap-3 text-white text-decoration-none">
                <i class="bi bi-shop fs-5"></i>
                @if (!isSidebarCollapsed)
                {
                    <span>Go to Storefront</span>
                }
            </a>
        </div>
    </aside>

    <!-- Main Content Panel -->
    <div class="flex-grow-1 d-flex flex-column" style="background: var(--color-bg); overflow-x: hidden;">
        <!-- Top Navigation Bar -->
        <header class="bg-white border-bottom d-flex align-items-center justify-content-between px-4" style="height: 70px; border-color: var(--color-border) !important;">
            <div class="d-flex align-items-center gap-3">
                @if (isSidebarCollapsed)
                {
                    <button class="btn btn-sm btn-link text-primary p-0 border-0" @onclick="ToggleSidebar" aria-label="Expand sidebar">
                        <i class="bi bi-chevron-right fs-4"></i>
                    </button>
                }
                <!-- Breadcrumbs -->
                <nav aria-label="breadcrumb" class="d-none d-sm-block">
                    <ol class="breadcrumb m-0" style="font-family: var(--font-display); font-weight: 700; font-size: 0.95rem;">
                        <li class="breadcrumb-item"><a href="admin/dashboard" class="text-decoration-none text-muted">Admin</a></li>
                        <li class="breadcrumb-item active text-primary" aria-current="page">@GetCurrentSection()</li>
                    </ol>
                </nav>
            </div>

            <!-- Logged-in admin info -->
            <div class="d-flex align-items-center gap-3">
                <AuthorizeView>
                    <Authorized>
                        <div class="dropdown">
                            <button class="btn d-flex align-items-center gap-2 border-0 dropdown-toggle" 
                                    type="button" 
                                    id="adminProfileButton" 
                                    data-bs-toggle="dropdown" 
                                    aria-expanded="false"
                                    style="background: rgba(74,171,219,0.08); border-radius: 100px; padding: 4px 12px;">
                                <div class="avatar bg-accent text-white rounded-circle d-flex align-items-center justify-content-center fw-bold" 
                                     style="width: 24px; height: 24px; font-size: 0.75rem;">
                                    @context.User.Identity?.Name?.Substring(0,1).ToUpper()
                                </div>
                                <span class="fw-bold font-display text-primary small">
                                    @context.User.Identity?.Name
                                </span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-md border-0 p-2 mt-2" aria-labelledby="adminProfileButton" style="border-radius: var(--radius-md);">
                                <li>
                                    <form action="Account/Logout" method="post" class="m-0">
                                        <AntiforgeryToken />
                                        <input type="hidden" name="ReturnUrl" value="" />
                                        <button type="submit" class="dropdown-item rounded-lg small py-2 text-danger w-100 text-start border-0 bg-transparent">
                                            <i class="bi bi-box-arrow-right me-2"></i>Log out
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </Authorized>
                </AuthorizeView>
            </div>
        </header>

        <!-- Dynamic Portal Body -->
        <main class="p-4" style="animation: fadeIn 0.4s ease;">
            @Body
        </main>
    </div>
</div>

<style>
    @@keyframes fadeIn {
        from { opacity: 0; }
        to { opacity: 1; }
    }
</style>

@code {
    private bool isSidebarCollapsed = false;

    private void ToggleSidebar() => isSidebarCollapsed = !isSidebarCollapsed;

    private string GetCurrentSection()
    {
        var uri = NavigationManager.Uri;
        if (uri.Contains("/categories")) return "Categories";
        if (uri.Contains("/products")) return "Products";
        if (uri.Contains("/companies")) return "Companies";
        if (uri.Contains("/users")) return "Users";
        if (uri.Contains("/orders")) return "Orders";
        return "Dashboard";
    }
}
